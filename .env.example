# Configuração local do Nexo.
#   1. cp .env.example .env
#   2. Preencha as variáveis abaixo
#   3. docker compose up -d postgres && cd nexo-server && mvn spring-boot:run
#
# O .env está no .gitignore: as chaves nunca vão para o repositório.
# Variáveis exportadas no terminal têm prioridade sobre este arquivo.

# ── Modelo (OpenAI ou proxy compatível) ─────────────────────────────────────────
OPENAI_API_KEY=
# Servidor compatível com a API da OpenAI (proxy LiteLLM, gateway da empresa...).
OPENAI_BASE_URL=https://api.openai.com/v1
# Precisa de gpt-5.4 ou mais novo para o tool search no cliente.
OPENAI_MODEL=gpt-5.4-mini
# Opcionais (vazio = padrão).
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_TIMEOUT_SECONDS=120

# ── Google OAuth (login e ferramentas) ──────────────────────────────────────────
# OAuth Client do tipo "Web application" no Google Cloud (doc 04, seção 2):
#   redirect URI: http://localhost:8080/login/oauth2/code/google
#   origem JavaScript: http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Chave que cifra os refresh tokens: 32 bytes em Base64 (openssl rand -base64 32).
# Vazia = chave aleatória a cada subida (os usuários precisam entrar de novo).
NEXO_TOKEN_KEY=
# NEXO_TOKEN_KEY_VERSION=1
# Origem do front (destino depois do login e única origem aceita no WebSocket).
# NEXO_WEB_ORIGIN=http://localhost:5173
# URL pública do servidor (monta o redirect URI do OAuth).
# NEXO_SERVER_URL=http://localhost:8080

# ── Banco (padrão = compose.yaml) ───────────────────────────────────────────────
# NEXO_DB_URL=jdbc:postgresql://127.0.0.1:5433/nexo
# NEXO_DB_USER=nexo
# NEXO_DB_PASSWORD=nexo
